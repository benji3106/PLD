# PATCH//ZERO works without any API key.
# This is the default and recommended starting mode for every student.
AI_PROVIDER=fixture

# -----------------------------------------------------------------------------
# LIVE AI - choose ONE provider and ONE model.
# Copy this file to .env, uncomment one block, then restart `npm start`.
# The model catalogue evolves: AI_MODEL is intentionally explicit and editable.
# -----------------------------------------------------------------------------

# OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-5.6-luna

# Google Gemini (OpenAI-compatible endpoint)
# AI_PROVIDER=gemini
# GEMINI_API_KEY=...
# AI_MODEL=gemini-3.6-flash

# xAI / Grok (`AI_PROVIDER=grok` is accepted as an alias)
# AI_PROVIDER=xai
# XAI_API_KEY=xai-...
# AI_MODEL=grok-4.6

# Mistral AI
# AI_PROVIDER=mistral
# MISTRAL_API_KEY=...
# AI_MODEL=mistral-large-latest

# Groq
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# AI_MODEL=openai/gpt-oss-20b

# OpenRouter (lets the student choose models from several vendors)
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# AI_MODEL=openrouter/free

# Any other OpenAI-compatible server / gateway / local endpoint.
# API key is optional here because some local servers do not require one.
# AI_PROVIDER=custom
# AI_BASE_URL=http://localhost:1234/v1
# AI_API_KEY=
# AI_MODEL=my-model

# Safety net: if a live provider fails, Agent Lab falls back to deterministic
# fixtures. Set to false only when you WANT provider errors to be blocking while
# debugging the live connection.
AI_FALLBACK_TO_FIXTURE=true

PORT=4177
